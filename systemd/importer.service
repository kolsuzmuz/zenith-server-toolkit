# Systemd service unit template for Zenith Session Importer
# Runs import_sessions.py in continuous background loop mode.

[Unit]
Description=Zenith Session Importer - Ingests sessions.log into SQLite
After=network.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/path/to/zenith-server-toolkit
Environment="PYTHONDONTWRITEBYTECODE=1"
# Environment="SESSIONS_LOG=/path/to/zenithproxy/sessions.log"
# Environment="SESSIONS_DB=/path/to/zenithproxy/sessions.db"
ExecStart=/usr/bin/python3 /path/to/zenith-server-toolkit/scripts/import_sessions.py --loop
Restart=always
RestartSec=5

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/path/to/zenithproxy /path/to/zenith-server-toolkit
PrivateTmp=true
MemoryMax=80M
CPUQuota=30%

[Install]
WantedBy=multi-user.target
